# Normalización de saltos de línea
* text=auto

# PowerShell y scripts Windows en CRLF al hacer checkout en Windows
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Markdown, JSON, TOML, CSS, JS normalizados
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
